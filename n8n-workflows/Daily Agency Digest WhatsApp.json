            "id": "ec921bb7-81ec-493b-97aa-25779e715fa5",
            "name": "Get Recipients",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                368,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const reportData = $node[\"Get Report Data\"].json;\nconst recipients = $input.all();\nconst agency = $node[\"Get WhatsApp Agencies\"].json;\n\n// Format date for template\nconst now = new Date();\nconst dateLabel = now.toLocaleDateString('en-GB', { \n  weekday: 'short', \n  day: 'numeric', \n  month: 'short' \n});\n\n// Format alerts (Variable 6 - Part 1)\nconst alerts = [\n  ...(reportData.actionItems?.criticalAlerts || []),\n  ...(reportData.actionItems?.warningAlerts || []),\n].slice(0, 3);\n\nlet alertText = alerts.length > 0\n  ? alerts.map(a => `• ${a.message}`).join('\\n')\n  : \"No urgent actions today.\";\n\n// Format Shift Schedule (Variable 6 - Part 2)\nlet scheduleText = \"\";\nif (reportData.clients && reportData.clients.length > 0) {\n  scheduleText = \"\\n\\n📍 *Shift Schedule*:\\n\";\n  reportData.clients.forEach(client => {\n    scheduleText += `\\n*${client.name.toUpperCase()}*\\n`;\n    \n    const confirmed = (client.shifts || []).filter(s => s.status === 'confirmed');\n    const assigned = (client.shifts || []).filter(s => s.status === 'assigned');\n    const open = (client.shifts || []).filter(s => s.status === 'open');\n    \n    if (confirmed.length > 0) {\n      scheduleText += `✅ ${confirmed.length} Confirmed\\n`;\n      confirmed.forEach(s => {\n        const time = s.startTime ? s.startTime.substring(0, 5) : '??:??';\n        const name = s.staffName ? s.staffName.split(' ')[0].toUpperCase() : 'STAFF';\n        scheduleText += `  └ ${time} ${name}\\n`;\n      });\n    }\n\n    if (assigned.length > 0) {\n      scheduleText += `🤝 ${assigned.length} Assigned\\n`;\n    }\n    \n    if (open.length > 0) {\n      scheduleText += `📋 ${open.length} Open Shifts\\n`;\n    }\n  });\n}\n\n// Combine for Variable 6\nconst combinedContent = alertText + scheduleText;\n\n// If no specific recipients, check if we should fallback to agency phone\nlet finalRecipients = recipients.map(r => r.json);\n\nif (finalRecipients.length === 0 && agency.phone) {\n  finalRecipients = [{\n    full_name: agency.name,\n    phone: agency.phone\n  }];\n}\n\nreturn finalRecipients.map(recipient => {\n  const nameToUse = recipient.full_name || agency.name || 'Admin';\n  return {\n    json: {\n      recipient_name: nameToUse.split(' ')[0],\n      date_label: dateLabel,\n      total_shifts: reportData.stats.totalShifts || 0,\n      utilization: reportData.stats.staffUtilization || 0,\n      pending_workflows: reportData.stats.pendingWorkflowsCount || 0,\n      combined_content: combinedContent,  // This goes into {{6}}\n      phone: recipient.phone\n    }\n  };\n});"
            },

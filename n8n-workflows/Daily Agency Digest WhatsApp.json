            "id": "get-recipients-ws",
            "name": "Get Recipients",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                368,
                0
            ]
        },
        {
            "parameters": {
                "jsCode": "const reportData = $node[\"Get Report Data\"].json;\nconst recipients = $input.all();\n\n// Format date - Sun 18 Jan (Exactly matching Meta sample - NO COMMA)\nconst now = new Date();\nconst dateLabel = now.toLocaleDateString('en-GB', { \n  weekday: 'short', \n  day: 'numeric', \n  month: 'short' \n});\n\nlet scheduleParts = [];\n\nconst topAlert = [\n  ...(reportData.actionItems?.criticalAlerts || []),\n].filter(a => !a.message.includes(reportData.stats?.pendingWorkflows))[0];\n\nif (topAlert) {\n  scheduleParts.push(`Alert: ${topAlert.message.replace(/[^\\x00-\\x7F]/g, \"\")}`);\n}\n\nif (reportData.clients && reportData.clients.length > 0) {\n  reportData.clients.forEach(client => {\n    const confirmed = (client.shifts || []).filter(s => s.status === 'confirmed').length;\n    const open = (client.shifts || []).filter(s => s.status === 'open').length;\n    \n    // PURE ASCII FORMAT: CLIENT: 2C / 1O\n    let line = `${client.name.toUpperCase()}: ${confirmed}C`;\n    if (open > 0) line += ` / ${open}O`;\n    scheduleParts.push(line);\n  });\n}\n\n// Flat string with pipe separator - NO NEWLINES\nlet keyUpdates = scheduleParts.join(' | ');\nif (!keyUpdates) keyUpdates = \"All systems operational\";\n\nreturn recipients.map(item => {\n  const res = item.json;\n  const rawName = (res.full_name || 'Admin').toString();\n  const displayName = rawName.split(/[, ]/)[0].trim();\n  \n  return {\n    json: {\n      recipient_name: String(displayName).replace(/[^\\x00-\\x7F]/g, \"\").substring(0, 30),\n      date_label: String(dateLabel).replace(/[^\\x00-\\x7F]/g, \"\"),\n      total_shifts: String(reportData.stats?.totalShifts || 0),\n      utilization: String(reportData.stats?.staffUtilization || 0) + '%', \n      pending_workflows: String(reportData.stats?.pendingWorkflows || 0),\n      schedule_summary: String(keyUpdates).replace(/[^\\x00-\\x7F]/g, \"\").substring(0, 800),\n      phone: res.phone.toString()\n    }\n  };\n});"
            },
            "id": "format-digest-code",
            "name": "Format Digest Data",
            "type": "n8n-nodes-base.code",

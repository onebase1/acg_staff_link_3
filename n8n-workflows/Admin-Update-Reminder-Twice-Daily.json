{
  "name": "Admin Update Reminder — Twice Daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 11 * * 1-5"
            }
          ]
        },
        "timezone": "Europe/London"
      },
      "id": "schedule-morning",
      "name": "11am Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 200]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 14 * * 1-5"
            }
          ]
        },
        "timezone": "Europe/London"
      },
      "id": "schedule-afternoon",
      "name": "2pm Weekdays",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 380]
    },
    {
      "parameters": {
        "jsCode": "const hour = new Date().toLocaleString('en-GB', { timeZone: 'Europe/London', hour: 'numeric', hour12: false });\nconst h = parseInt(hour);\nconst isMorning = h < 13;\n\nreturn [{\n  json: {\n    isMorning,\n    session: isMorning ? 'morning' : 'afternoon',\n    subject: isMorning\n      ? 'Quick check — anything to update on the system this morning?'\n      : 'Afternoon check — any shifts or staff changes to add before close?',\n    greeting: isMorning\n      ? 'Hope your morning is going well.'\n      : 'Hope the afternoon is going smoothly.',\n    context: isMorning\n      ? 'Before the day gets busy, worth a quick check to make sure everything is loaded and up to date.'\n      : 'Before you wrap up for the day, here is a quick checklist to make sure nothing has been missed.',\n    sessionLabel: isMorning ? 'Morning' : 'Afternoon'\n  }\n}];"
      },
      "id": "set-session",
      "name": "Set Session Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 290]
    },
    {
      "parameters": {
        "sendTo": "info@dhcservices.ltd.co.uk",
        "subject": "={{ $json.subject }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n</head>\n<body style=\"margin:0;padding:0;background:#f3f4f6;font-family:Arial,Helvetica,sans-serif;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f3f4f6;padding:24px 0;\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"580\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:580px;width:100%;background:#ffffff;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);\">\n\n          <!-- Header -->\n          <tr>\n            <td style=\"background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);padding:28px 36px;\">\n              <p style=\"margin:0;font-size:13px;color:rgba(255,255,255,0.75);letter-spacing:1px;text-transform:uppercase;\">ACG StaffLink</p>\n              <h1 style=\"margin:6px 0 0;font-size:22px;color:#ffffff;font-weight:700;\">{{ $json.sessionLabel }} System Check</h1>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding:32px 36px;\">\n              <p style=\"margin:0 0 8px;color:#374151;font-size:15px;\">Hi,</p>\n              <p style=\"margin:0 0 20px;color:#374151;font-size:15px;line-height:1.6;\">{{ $json.greeting }} {{ $json.context }}</p>\n\n              <!-- Checklist -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background:#f8f7ff;border-left:4px solid #667eea;border-radius:0 8px 8px 0;margin-bottom:24px;\">\n                <tr>\n                  <td style=\"padding:20px 24px;\">\n                    <p style=\"margin:0 0 14px;font-size:13px;font-weight:700;color:#667eea;text-transform:uppercase;letter-spacing:0.5px;\">Today's checklist</p>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                      <tr>\n                        <td width=\"28\" valign=\"top\" style=\"padding-top:1px;\"><div style=\"width:22px;height:22px;background:#667eea;border-radius:50%;text-align:center;line-height:22px;font-size:12px;color:#fff;font-weight:700;\">1</div></td>\n                        <td style=\"padding-left:10px;\"><span style=\"font-weight:700;color:#1f2937;font-size:14px;\">New shifts</span><br><span style=\"color:#6b7280;font-size:13px;\">Any new shifts confirmed or received today that need adding?</span></td>\n                      </tr>\n                    </table>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                      <tr>\n                        <td width=\"28\" valign=\"top\" style=\"padding-top:1px;\"><div style=\"width:22px;height:22px;background:#667eea;border-radius:50%;text-align:center;line-height:22px;font-size:12px;color:#fff;font-weight:700;\">2</div></td>\n                        <td style=\"padding-left:10px;\"><span style=\"font-weight:700;color:#1f2937;font-size:14px;\">Staff assignments</span><br><span style=\"color:#6b7280;font-size:13px;\">Are all upcoming shifts assigned to the right staff members?</span></td>\n                      </tr>\n                    </table>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                      <tr>\n                        <td width=\"28\" valign=\"top\" style=\"padding-top:1px;\"><div style=\"width:22px;height:22px;background:#667eea;border-radius:50%;text-align:center;line-height:22px;font-size:12px;color:#fff;font-weight:700;\">3</div></td>\n                        <td style=\"padding-left:10px;\"><span style=\"font-weight:700;color:#1f2937;font-size:14px;\">Staff changes</span><br><span style=\"color:#6b7280;font-size:13px;\">New starters, leavers, suspensions, or role changes to record?</span></td>\n                      </tr>\n                    </table>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                      <tr>\n                        <td width=\"28\" valign=\"top\" style=\"padding-top:1px;\"><div style=\"width:22px;height:22px;background:#764ba2;border-radius:50%;text-align:center;line-height:22px;font-size:12px;color:#fff;font-weight:700;\">4</div></td>\n                        <td style=\"padding-left:10px;\"><span style=\"font-weight:700;color:#1f2937;font-size:14px;\">Pending timesheets</span><br><span style=\"color:#6b7280;font-size:13px;\">Any submitted timesheets waiting for your approval?</span></td>\n                      </tr>\n                    </table>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                      <tr>\n                        <td width=\"28\" valign=\"top\" style=\"padding-top:1px;\"><div style=\"width:22px;height:22px;background:#764ba2;border-radius:50%;text-align:center;line-height:22px;font-size:12px;color:#fff;font-weight:700;\">5</div></td>\n                        <td style=\"padding-left:10px;\"><span style=\"font-weight:700;color:#1f2937;font-size:14px;\">Client updates</span><br><span style=\"color:#6b7280;font-size:13px;\">Any changes to care requirements, locations, or contacts?</span></td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin:0 0 24px;color:#6b7280;font-size:14px;line-height:1.6;\">Keeping things current means staff get the right notifications, payroll runs smoothly, and nothing falls through the gaps.</p>\n\n              <!-- CTA -->\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td style=\"background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);border-radius:8px;\">\n                    <a href=\"https://acgstafflink.netlify.app/Dashboard\" style=\"display:inline-block;padding:13px 28px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;\">Open Admin Dashboard &rarr;</a>\n                  </td>\n                </tr>\n              </table>\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding:0 36px 28px;border-top:1px solid #f3f4f6;\">\n              <p style=\"margin:20px 0 0;color:#9ca3af;font-size:12px;text-align:center;\">&copy; 2026 Agile Care Management. All rights reserved.</p>\n              <p style=\"margin:6px 0 0;color:#d1d5db;font-size:11px;text-align:center;\">Sent at 11:00 and 14:00 (UK time), Monday to Friday.</p>\n            </td>\n          </tr>\n\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>",
        "options": {
          "fromName": "Kylie from ACG"
        }
      },
      "id": "send-email",
      "name": "Send Reminder Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [760, 290]
    }
  ],
  "connections": {
    "11am Weekdays": {
      "main": [
        [{ "node": "Set Session Context", "type": "main", "index": 0 }]
      ]
    },
    "2pm Weekdays": {
      "main": [
        [{ "node": "Set Session Context", "type": "main", "index": 0 }]
      ]
    },
    "Set Session Context": {
      "main": [
        [{ "node": "Send Reminder Email", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/London"
  },
  "tags": ["admin", "reminder", "scheduled"],
  "meta": {
    "instanceId": ""
  }
}
